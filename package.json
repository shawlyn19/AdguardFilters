    "engines": {
        "node": ">=18.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AdguardTeam/AdguardFilters.git"
    },
    "bugs": {
        "url": "https://github.com/AdguardTeam/AdguardFilters/issues"
    },
    "homepage": "https://github.com/AdguardTeam/AdguardFilters#readme",
    "//": "Resolves GHSA-3ppc-4f35-3m26 (minimatch) and GHSA-38c4-r59v-3vqw (markdown-it)",
    "overrides": {
        "minimatch": "10.2.4",
        "markdown-it": "14.1.1"
    },
    "scripts": {
        "aglint": "aglint",
        "markdownlint": "markdownlint .",
