        "*.txt": "aglint",
        "*.md": "markdownlint"
    },
    "devDependencies": {
        "@adguard/aglint": "3.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.6",
        "markdownlint": "0.40.0",
        "markdownlint-cli": "0.47.0"
